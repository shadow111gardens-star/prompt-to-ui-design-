# ============================================================
#  OpenUI — Configuration
# ============================================================
# Generation uses only the fixed server-side Gemini model.
# Other provider fields are legacy configuration and do not route generation.
# ============================================================

# Automatic model fallback is disabled.

# --- OpenRouter (https://openrouter.ai) ---
OPENROUTER_API_KEY=

# --- NVIDIA NIM (https://build.nvidia.com) ---
NVIDIA_NIM_API_KEY=

# --- Ollama (https://ollama.com) ---
# Set OLLAMA_ENABLED=true if running Ollama locally
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- OpenAI (https://platform.openai.com) ---
OPENAI_API_KEY=

# --- Active fixed Google AI generation (https://aistudio.google.com) ---
# Never use NEXT_PUBLIC_ for provider keys.
GEMINI_API_KEY=
# Optional; leave unset to use this fixed model. Other IDs are rejected.
GEMINI_MODEL=gemini-3.5-flash-lite

# ============================================================
#  App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web App (public SDK identifiers; obtain all values from Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# UI-only Lifetime preview for local testing; never grants API access.
OPENUI_LIFETIME_UI_PREVIEW=false

# 32-byte base64 encryption key. Generate locally; never expose with NEXT_PUBLIC_.
OPENUI_PROVIDER_KEYS_SECRET=
# Enable only on localhost with next dev for authenticated BYOK testing.
OPENUI_LOCAL_BYOK_TESTING=false

# Server-only Pixabay search key. Never prefix with NEXT_PUBLIC_.
PIXABAY_API_KEY=

# PostgreSQL: server-only pooled runtime and direct Prisma CLI connections.
DATABASE_URL=
DIRECT_URL=

# Dodo Payments and persistent AI Credits (apply reviewed additive schema before production deployment).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_BUSINESS_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PLUS_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
DODO_LIFETIME_PRODUCT_ID=
OPENUI_PUBLIC_ORIGIN=
# Required separate positive USD limit for Pro; no inherited Plus budget.
OPENUI_PRO_PERIOD_SPEND_LIMIT_USD=
# Opt into billing in local development; production always enforces billing.
OPENUI_CREDITS_ENABLED=false
