# ============================================================
#  OpenUI — Configuration
# ============================================================
# Enable AI providers by adding their API keys below.
# Every provider with a valid key will appear in the model
# selector dropdown. You can enable as many as you want.
# ============================================================

# --- REQUIRED: Fallback Model ---
# Format: provider/model-id
# Used when the selected model fails to respond.
NEXT_PUBLIC_OPENUI_FALLBACK_MODEL=openrouter/qwen/qwen3.7-plus

# --- OpenRouter (https://openrouter.ai) ---
OPENROUTER_API_KEY=

# --- NVIDIA NIM (https://build.nvidia.com) ---
NVIDIA_NIM_API_KEY=

# --- Ollama (https://ollama.com) ---
# Set OLLAMA_ENABLED=true if running Ollama locally
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- OpenAI (https://platform.openai.com) ---
OPENAI_API_KEY=

# --- Google AI (https://aistudio.google.com) ---
GEMINI_API_KEY=

# ============================================================
#  App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web App (public SDK identifiers; obtain all values from Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# UI-only Lifetime preview for local testing; never grants API access.
OPENUI_LIFETIME_UI_PREVIEW=false

# 32-byte base64 encryption key. Generate locally; never expose with NEXT_PUBLIC_.
OPENUI_PROVIDER_KEYS_SECRET=
# Enable only on localhost with next dev for authenticated BYOK testing.
OPENUI_LOCAL_BYOK_TESTING=false

# Server-only Pixabay search key. Never prefix with NEXT_PUBLIC_.
PIXABAY_API_KEY=
